# Aicoo deployment the app runs against.
# Use http://localhost:3000 only when developing against the sibling pulse repo.
AICOO_BASE_URL=https://www.aicoo.io

# OAuth client credentials — REQUIRED. Aicoo has disabled anonymous dynamic
# client registration (/api/auth/oauth2/register now returns 403 "Client
# registration is disabled"), so the BFF can no longer self-register. Register a
# confidential client in Aicoo's Developer Portal (Account → Developer →
# Developer Portal → New Client) and paste its credentials here. The client's
# Redirect URI must exactly equal AICOO_REDIRECT_URI below.
AICOO_CLIENT_ID=
AICOO_CLIENT_SECRET=
AICOO_REDIRECT_URI=http://localhost:8787/auth/callback

# Long random string for encrypting the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Separate pepper for opaque player IDs and synthetic-vault commitments.
ARENA_SECRET=change-me-to-a-different-long-random-string

# Arena operator: an Aicoo account whose workspace stores the roster and proof ledger.
AICOO_OPERATOR_API_KEY=

PORT=8787
SPA_URL=http://localhost:3000

# ── 相亲小镇 model layer (single source of truth for every agent call) ──
# All town model calls (target selection, decisions, conversation, memory,
# relationship updates, story threads, feed summaries) run on Grok.
XAI_API_KEY=""
GROK_MODEL="grok-4"
# XAI_BASE_URL="https://api.x.ai/v1"
# GROK_TIMEOUT_MS="60000"
# GROK_MAX_RETRIES="2"
# Real conversation turns each agent may spend per calendar day.
TOWN_DAILY_TURNS="100"
