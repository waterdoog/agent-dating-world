# Aicoo deployment the app runs against.
# Use http://localhost:3000 only when developing against the sibling pulse repo.
AICOO_BASE_URL=https://www.aicoo.io

# OAuth client credentials — REQUIRED. Aicoo has disabled anonymous dynamic
# client registration (/api/auth/oauth2/register now returns 403 "Client
# registration is disabled"), so the BFF can no longer self-register. Register a
# confidential client in Aicoo's Developer Portal (Account → Developer →
# Developer Portal → New Client) and paste its credentials here. The client's
# Redirect URI must exactly equal AICOO_REDIRECT_URI below.
AICOO_CLIENT_ID=
AICOO_CLIENT_SECRET=
AICOO_REDIRECT_URI=http://localhost:8787/auth/callback

# Exact public origin of the BFF. In production, use the same HTTPS origin as
# the SPA so OAuth flow/session cookies remain first-party.
BFF_PUBLIC_URL=http://localhost:8787

# Long random string for encrypting the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Separate secret for opaque player IDs.
ARENA_SECRET=change-me-to-a-different-long-random-string

# Dedicated N1 service account. It owns synthetic Fighter capsules, snapshots,
# short-lived encounter links, and the model credits used by guest execution.
# Do not use a personal COO workspace; set its public profile name to
# "Virtual N1 World" because Aicoo currently exposes the link owner's DB name.
AICOO_OPERATOR_API_KEY=

# Supabase Postgres.
# The running BFF uses the pooled URL. Migration and administrative commands
# prefer the direct, non-pooling URL. These values are server-only: never prefix
# them with VITE_ or expose them to browser code.
n1_POSTGRES_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/DATABASE?sslmode=require
n1_POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require

PORT=8787
SPA_URL=http://localhost:3000

# Standalone Blackjack reads the same Aicoo session through the World shell.
WORLD_SHELL_ORIGIN=http://localhost:3000
